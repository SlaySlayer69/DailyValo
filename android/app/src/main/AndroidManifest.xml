<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talking to Riot's APIs and loading skin artwork from the content CDN. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Posting the daily-shop digest and wishlist alerts. Runtime-requested
         on Android 13+; granted at install time below that. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- WorkManager re-registers the shop check after a reboot so a device that
         restarts overnight still gets its 00:00 UTC notification. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Lets the background check finish a request that started just as the
         screen went off, instead of being cut mid-flight. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- Delivering a notification at the minute the user picked. Without it,
         Android batches the alarm into the next Doze maintenance window, so a
         digest set for 09:00 arrives whenever the phone next wakes up. Denied
         by default on Android 14+ and requested only once a delivery time has
         actually been chosen; the app falls back to an inexact alarm if the
         user says no. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>

    <application
        android:label="DailyValo"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Delivery of every scheduled notification.
             `zonedSchedule` hands AlarmManager a PendingIntent aimed at this
             receiver. Without the declaration the alarm is still registered —
             it shows up in `pendingNotificationRequests` and looks perfectly
             healthy — but when it fires there is nothing to deliver the
             broadcast to, and it is dropped in silence. Immediate `show()`
             calls are unaffected, which is why notifications appeared to work
             right up until a delivery time was set.
             The plugin stopped declaring these in its own manifest in v16; the
             app has to. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />

        <!-- Re-arms pending alarms after a reboot or an app update. AlarmManager
             forgets everything on both, so without this a phone restarted
             overnight loses its morning digest. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Home screen widget. Reads what Flutter wrote via home_widget, so it
             renders while the app is not running. -->
        <receiver
            android:name=".DailyShopWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/daily_shop_widget_info" />
        </receiver>
    </application>

    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
