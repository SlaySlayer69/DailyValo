<?xml version="1.0" encoding="utf-8"?>
<!-- Four tiles side by side on black. Each FrameLayout is tinted at runtime to
     the skin's rarity colour and pads the image by 2dp, which is what produces
     the coloured frame — RemoteViews cannot restyle a drawable's stroke. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <FrameLayout
        android:id="@+id/tile_frame_0"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="0dp"
        android:padding="2dp">

        <ImageView
            android:id="@+id/tile_image_0"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/widget_tile_background"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:contentDescription="@string/widget_tile_description" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/tile_frame_1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:padding="2dp">

        <ImageView
            android:id="@+id/tile_image_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/widget_tile_background"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:contentDescription="@string/widget_tile_description" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/tile_frame_2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:padding="2dp">

        <ImageView
            android:id="@+id/tile_image_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/widget_tile_background"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:contentDescription="@string/widget_tile_description" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/tile_frame_3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:padding="2dp">

        <ImageView
            android:id="@+id/tile_image_3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/widget_tile_background"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:contentDescription="@string/widget_tile_description" />
    </FrameLayout>
</LinearLayout>
