<?xml version="1.0" encoding="utf-8"?>
<!-- Roughly square: a 2x2 grid of landscape tiles, sized so a weapon render
     has room to be seen rather than shrunk into a strip. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="150dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:initialLayout="@layout/daily_shop_widget"
    android:previewLayout="@layout/daily_shop_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description"
    android:updatePeriodMillis="1800000" />
